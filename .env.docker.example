# Local Docker-only values. Copy to .env.docker and replace both passwords.
WEB_PORT=82
APP_SECRET=replace-with-a-random-64-character-hex-secret
MYSQL_DATABASE=quai_antique_docker
MYSQL_USER=quai_app
MYSQL_PASSWORD=replace-with-a-long-alphanumeric-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-alphanumeric-password
DATABASE_URL=mysql://quai_app:replace-with-a-long-alphanumeric-password@database:3306/quai_antique_docker?serverVersion=8.4.13&charset=utf8mb4
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$
