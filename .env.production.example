# Modèle uniquement : ne jamais publier ces valeurs de remplacement.
# Copier vers .env.production et définir de vrais secrets dans l'environnement cible.
WEB_PORT=8086
APP_SECRET=replace-with-a-random-secret-at-least-32-characters
MYSQL_DATABASE=quai_antique
MYSQL_USER=quai_app
MYSQL_PASSWORD=replace-with-a-long-random-hex-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-hex-password
DATABASE_URL=mysql://quai_app:replace-with-a-long-random-hex-password@database:3306/quai_antique?serverVersion=8.4.13&charset=utf8mb4
CORS_ALLOW_ORIGIN=^https://quai-antique\.example\.invalid$
DEFAULT_URI=https://quai-antique.example.invalid
