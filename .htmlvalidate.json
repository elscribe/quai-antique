{
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "doctype-style": "off",
    "form-dup-name": [
      "error",
      {
        "shared": [
          "radio",
          "checkbox",
          "button",
          "reset",
          "submit"
        ]
      }
    ],
    "void-style": "off"
  }
}
